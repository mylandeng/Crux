CURX_APP_ENV=local
CURX_APP_HOST=127.0.0.1
CURX_APP_PORT=8020
CURX_DATABASE_URL=postgresql+psycopg://curx:curx@127.0.0.1:5433/curx
CURX_REDIS_URL=redis://127.0.0.1:6380/0
CURX_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9010
CURX_OBJECT_STORE_ACCESS_KEY=curx-minio
CURX_OBJECT_STORE_SECRET_KEY=curx-minio-secret
CURX_OBJECT_STORE_BUCKET=curx-sources
CURX_INGESTION_INLINE=false
CURX_INGESTION_MAX_UPLOAD_BYTES=26214400
CURX_CHUNK_MAX_TOKENS=600
CURX_CHUNK_OVERLAP_TOKENS=80
CURX_EMBEDDING_PROVIDER=local
CURX_EMBEDDING_MODEL_NAME=hash-embedding-v1
CURX_EMBEDDING_DIMENSION=384
CURX_EMBEDDING_API_KEY=
CURX_EMBEDDING_BASE_URL=
# Local HTTP only. Keep true behind HTTPS in production.
CURX_SESSION_COOKIE_SECURE=false
CURX_SESSION_TTL_HOURS=12
CURX_AUTH_REQUIRED=true
CURX_AUTH_ATTEMPT_LIMIT=5
CURX_AUTH_ATTEMPT_WINDOW_SECONDS=300
CURX_MODEL_PROVIDER=openai
CURX_MODEL_NAME=gpt-4.1-mini
CURX_MODEL_API_KEY=
CURX_MODEL_BASE_URL=
CURX_MODEL_TEMPERATURE=0.2

POSTGRES_DB=curx
POSTGRES_USER=curx
POSTGRES_PASSWORD=curx
MINIO_ROOT_USER=curx-minio
MINIO_ROOT_PASSWORD=curx-minio-secret
